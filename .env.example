# Copie para .env. Obtenha os valores no Firebase > Configurações > Seus apps > Web.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google nativo (a versão web usa o provedor configurado no Firebase).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Para a build iOS: com.googleusercontent.apps.SEUIDINVERTIDO
GOOGLE_IOS_URL_SCHEME=
# Para mostrar o mapa numa build própria Android, ative o Maps SDK na sua conta.
GOOGLE_MAPS_ANDROID_API_KEY=
